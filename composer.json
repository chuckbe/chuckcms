{
    "name": "chuckbe/chuckcms",
    "description": "A lightweight Laravel CMS for easy control of a website.",
    "keywords": ["chuckbe", "chuckcms", "cms", "laravel", "php"],
    "homepage": "https://github.com/chuckbe/chuckcms",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0||^11.0||^12.0",
        "laravel/ui": "^4.2",
        "barryvdh/laravel-dompdf": "^3.0",
        "mcamara/laravel-localization": "^2.0",
        "spatie/eloquent-sortable": "^4.0",
        "spatie/laravel-honeypot": "^4.5",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-translatable": "^6.3",
        "spatie/laravel-sitemap": "^7.2",
        "unisharp/laravel-filemanager": "^2.6"
    },
    "authors": [
        {
            "name": "Karel Brijs",
            "email": "karel@chuck.be"
        }
    ],
    "autoload": {
        "psr-4": {
            "Chuckbe\\Chuckcms\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chuckbe\\Chuckcms\\ChuckcmsServiceProvider"
            ],
            "aliases": {
                "ChuckTemplate": "Chuckbe\\Chuckcms\\Facades\\Template",
                "Honeypot": "Chuckbe\\Chuckcms\\Chuck\\Support\\Honeypot"
            }
        }
    },
    "minimum-stability": "dev",
    "require-dev": {
        "orchestra/testbench": "^8.0||^9.0||^10.0"
    },
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Chuckbe\\Chuckcms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
